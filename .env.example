# Copy this file to .env and replace every change_me value. Never commit .env.

# User Management Service
USER_MANAGEMENT_API_PORT=5010
USER_MANAGEMENT_DB_NAME=user_management
USER_MANAGEMENT_DB_USER=change_me
USER_MANAGEMENT_DB_PASSWORD=change_me_to_a_strong_password
USER_MANAGEMENT_DB_HOST=user-management-db
USER_MANAGEMENT_DB_PORT=5432
USER_MANAGEMENT_DB_PUBLISHED_PORT=5433

# Battle Service
BATTLE_API_PORT=5020
BATTLE_DB_NAME=battle
BATTLE_DB_USER=change_me
BATTLE_DB_PASSWORD=change_me_to_a_strong_password
BATTLE_DB_HOST=battle-db
BATTLE_DB_PORT=5432
BATTLE_DB_PUBLISHED_PORT=5434

# Map Service
MAP_API_PORT=5030
MAP_REDIS_PASSWORD=change_me_to_a_strong_password
MAP_REDIS_PUBLISHED_PORT=6380

# Monster Raid Service
MONSTER_RAID_API_PORT=5040
MONSTER_RAID_DB_NAME=monster_raid
MONSTER_RAID_DB_USER=change_me
MONSTER_RAID_DB_PASSWORD=change_me_to_a_strong_password
MONSTER_RAID_DB_PUBLISHED_PORT=5435
MONSTER_RAID_REDIS_PASSWORD=change_me_to_a_strong_password
MONSTER_RAID_REDIS_PUBLISHED_PORT=6381

# Guild Service
GUILD_API_PORT=8081
GUILD_DB_NAME=guild_service
GUILD_DB_USER=change_me
GUILD_DB_PASSWORD=change_me_to_a_strong_password
GUILD_DB_PUBLISHED_PORT=5436

# Package Registry Service
PACKAGE_REGISTRY_API_PORT=8082
PACKAGE_REGISTRY_DB_NAME=package_registry
PACKAGE_REGISTRY_DB_USER=change_me
PACKAGE_REGISTRY_DB_PASSWORD=change_me_to_a_strong_password
PACKAGE_REGISTRY_DB_PUBLISHED_PORT=5437

# Shared
# JWT_SIGNING_KEY: one private key of at least 32 UTF-8 characters, used by the User Management and Battle services.
# DOCS_ENABLED: serves the OpenAPI document and Swagger UI of the Map and Monster Raid services.
JWT_SIGNING_KEY=change_me_to_a_private_key_of_at_least_32_characters
DOCS_ENABLED=true

TAMAGOTCHI_DB_NAME=tamagotchi
TAMAGOTCHI_DB_USER=change_me
TAMAGOTCHI_DB_PASSWORD=change_me_to_a_strong_password
TAMAGOTCHI_API_PORT=5050
TAMAGOTCHI_DB_PUBLISHED_PORT=5438

NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=change_me
NOTIFICATION_DB_PASSWORD=change_me_to_a_strong_password
NOTIFICATION_API_PORT=5060
NOTIFICATION_DB_PUBLISHED_PORT=5439
NOTIFICATION_REDIS_PASSWORD=change_me_to_a_strong_password
