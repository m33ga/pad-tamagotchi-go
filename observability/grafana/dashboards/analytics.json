  "panels": [
    {
      "type": "row",
      "title": "ETL",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Last extract per source",
      "description": "The latest scheduled extract of each source: failed if any of its views failed (after the task's retries), its duration, the rows it loaded and when it ended.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "success": {
                  "color": "green",
                  "index": 0
                },
                "failed": {
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT source, if(countIf(state = 'failed') > 0, 'failed', 'success') AS state, max(finished) AS ended, dateDiff('millisecond', min(started), max(finished)) / 1000 AS duration_seconds, sum(rows) AS rows FROM (SELECT source, target, argMax(state, finished_at) AS state, min(started_at) AS started, max(finished_at) AS finished, argMax(rows, finished_at) AS rows FROM meta.runs WHERE kind = 'extract' AND (source, run_id) IN (SELECT source, argMax(run_id, finished_at) FROM meta.runs WHERE kind = 'extract' GROUP BY source) GROUP BY source, target) GROUP BY source ORDER BY source"
        }
      ],
      "id": 2
    },
    {
      "type": "bargauge",
      "title": "Freshness per source",
      "description": "Now minus the newest change loaded from the source (the highest watermark of its views). Red past 15 minutes: the extracts run every 5, so the source has not been read for at least two cycles, or nothing in it has changed.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT source, dateDiff('second', max(watermark), now64(3)) AS freshness_seconds FROM meta.watermarks FINAL GROUP BY source ORDER BY source"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Extract duration per source",
      "description": "Each scheduled extract run of a source, from its first view's start to its last view's end.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT max(finished_at) AS time, source, dateDiff('millisecond', min(started_at), max(finished_at)) / 1000 AS duration_seconds FROM meta.runs WHERE kind = 'extract' AND $__timeFilter(finished_at) GROUP BY source, run_id ORDER BY time"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Rows loaded per run",
      "description": "Rows each extract run loaded into staging, per source, including the rows the 5-minute overlap reads again.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT max(finished_at) AS time, source, sum(rows) AS rows FROM meta.runs WHERE kind = 'extract' AND state = 'success' AND $__timeFilter(finished_at) GROUP BY source, run_id ORDER BY time"
        }
      ],
      "id": 5
    },
    {
