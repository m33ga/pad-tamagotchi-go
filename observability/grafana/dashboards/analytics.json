    {
      "type": "table",
      "title": "Rows and bytes per table",
      "description": "Every staging and warehouse table: rows and compressed bytes on disk, from the active parts.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 6,
