      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT multiIf(level < 5, '1-4', level < 10, '5-9', level < 20, '10-19', level < 50, '20-49', '50+') AS band, count() AS tamagotchis FROM dw.dim_tamagotchi FINAL GROUP BY band ORDER BY min(level)"
        }
      ],
      "id": 9
