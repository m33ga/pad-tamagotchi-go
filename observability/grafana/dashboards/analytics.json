        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toStartOfDay(transferred_at) AS time, countIf(reverted_at IS NULL) AS kept, countIf(reverted_at IS NOT NULL) AS reverted FROM dw.fact_transfer FINAL WHERE $__timeFilter(transferred_at) GROUP BY time ORDER BY time"
        }
      ],
      "id": 8
    },
    {
      "type": "barchart",
      "title": "Tamagotchis per level band",
      "description": "How many Tamagotchis are at each level band now.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
