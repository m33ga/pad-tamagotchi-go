    {
      "type": "timeseries",
      "title": "XP granted per day by source",
      "description": "XP granted per day from battles and raids. XP whose grant was revoked (its battle's settlement was compensated) is its own series, not counted in the others.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toStartOfDay(created_at) AS time, sumIf(amount, source = 'BATTLE' AND revoked_at IS NULL) AS battle, sumIf(amount, source = 'RAID' AND revoked_at IS NULL) AS raid, sumIf(amount, revoked_at IS NOT NULL) AS revoked FROM dw.fact_xp FINAL WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Transfers per day",
      "description": "Ownership transfers per day (a battle's winner takes the loser's primary), and those later reverted because the battle was voided.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
