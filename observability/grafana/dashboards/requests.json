{
  "uid": "requests",
  "title": "Requests",
  "description": "Latency percentiles and error rates per service and instance: from OpenTelemetry metrics where a service exports them, and from the request log lines (status, durationMs) of every service.",
  "tags": [
    "tamagotchi-go"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_request_duration_seconds_count, job)",
        "definition": "label_values(http_server_request_duration_seconds_count, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_request_duration_seconds_count{job=~\"$service\"}, instance)",
        "definition": "label_values(http_server_request_duration_seconds_count{job=~\"$service\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "log_service",
        "label": "Service (logs)",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "definition": "",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "tamagotchi-go"
      ],
      "asDropdown": true,
      "title": "Dashboards"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "From OpenTelemetry metrics",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 15,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (job, le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 15,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 15,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error rate (5xx share)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "(sum by (job, instance) (rate(http_server_request_duration_seconds_count{job=~\"$service\", instance=~\"$instance\", http_response_status_code=~\"5..\"}[5m])) or sum by (job, instance) (rate(http_server_request_duration_seconds_count{job=~\"$service\", instance=~\"$instance\"}[5m])) * 0) / sum by (job, instance) (rate(http_server_request_duration_seconds_count{job=~\"$service\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{job}} / {{instance}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 0.05
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (job, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$service\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{job}} {{http_response_status_code}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "From request log lines",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {service_name=~\"$log_service\"} | event=\"request\" | unwrap durationMs [5m]) by (service_name, service_instance_id)",
          "legendFormat": "{{service_name}} / {{service_instance_id}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Error rate (5xx share)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "expr": "(sum by (service_name) (count_over_time({service_name=~\"$log_service\"} | event=\"request\" | status >= 500 [5m])) or sum by (service_name) (count_over_time({service_name=~\"$log_service\"} | event=\"request\" [5m])) * 0) / sum by (service_name) (count_over_time({service_name=~\"$log_service\"} | event=\"request\" [5m]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 0.05
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests per instance",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (service_name, service_instance_id) (count_over_time({service_name=~\"$log_service\"} | event=\"request\" [1m]))",
          "legendFormat": "{{service_name}} / {{service_instance_id}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    }
  ]
}
