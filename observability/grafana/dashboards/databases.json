      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(redis_keys_evicted_total{job=\"redis\", instance=~\"cache-.*\"}[5m]))",
          "legendFormat": "{{instance}}",
