{
  "openapi": "3.1.0",
  "info": {
    "title": "Guild Service API",
    "version": "1.0.0",
    "description": "Owns guild identity, membership, roles, permissions, and Guild Chat. Guilds, memberships, membership requests and chat messages are stored in PostgreSQL. The service uses User Management Service for user identity and relationships and Package Registry Service only when a guild restricts membership to a package. The real-time Guild Chat WebSocket contract at `/ws/v1/guilds/{guildId}/chat` cannot be expressed in OpenAPI and is documented in the repository README.\n\nThe service publishes the `guild.invitation.created.v1` queue event. Event payload schemas are included under components for reference; events are delivered through the message queue using the common event envelope, not over HTTP.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API Gateway base path"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Guilds",
      "description": "Guild lifecycle and ownership"
    },
    {
      "name": "Members",
      "description": "Guild memberships and roles"
    },
    {
      "name": "Invitations",
      "description": "Guild invitations and their resolution"
    },
    {
      "name": "Messages",
      "description": "Guild Chat message history over REST"
    }
  ],
  "paths": {
    "/guilds": {
      "get": {
        "operationId": "listGuilds",
        "summary": "List guilds",
        "description": "Callable by clients.",
        "tags": ["Guilds"],
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Guild page returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuildPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query: INVALID_QUERY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createGuild",
        "summary": "Create a new guild",
        "description": "Callable by clients. The creator becomes the guild owner.",
        "tags": ["Guilds"],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGuildRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New guild created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuildResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: PACKAGE_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: GUILD_NAME_TAKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/guilds/{guildId}": {
      "get": {
        "operationId": "getGuild",
        "summary": "Retrieve a guild",
        "description": "Callable by clients and Monster Raid Service.",
        "tags": ["Guilds"],
        "parameters": [
          {
            "$ref": "#/components/parameters/GuildId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Guild returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuildResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Not found: GUILD_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateGuild",
        "summary": "Update a guild",
        "description": "Callable only by the guild owner.",
        "tags": ["Guilds"],
        "parameters": [
          {
            "$ref": "#/components/parameters/GuildId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGuildRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guild updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuildResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict: GUILD_NAME_TAKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteGuild",
        "summary": "Delete a guild",
        "description": "Callable only by the guild owner.",
        "tags": ["Guilds"],
        "parameters": [
          {
            "$ref": "#/components/parameters/GuildId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "204": {
            "description": "Guild deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict: ACTIVE_RAID_EXISTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}/guilds": {
      "get": {
        "operationId": "getUserGuilds",
        "summary": "List the guilds a user belongs to",
        "description": "Callable by the account owner or internal services.",
