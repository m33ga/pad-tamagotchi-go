    },
    "/guilds/{guildId}/members/{userId}": {
      "get": {
        "operationId": "getGuildMember",
        "summary": "Retrieve a guild membership",
        "description": "Callable by guild members and Monster Raid Service.",
        "tags": ["Members"],
        "parameters": [
          {
            "$ref": "#/components/parameters/GuildId"
          },
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Membership returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuildMemberResponse"
