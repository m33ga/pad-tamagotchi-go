{
  "openapi": "3.1.0",
  "info": {
    "title": "Map Service API",
    "version": "3.0.0",
    "description": "Owns current location state and map visibility calculations. Clients continuously replace their latest location. The service keeps only the newest location for each user in Redis with a TTL, so a position that stops being refreshed disappears from the map on its own. Proximity markers, which keep continuous location updates from producing duplicate detection events, are kept in Redis as well.\n\nThe service publishes the `map.proximity.detected.v1` queue event. Event payload schemas are included under components for reference; events are delivered through the message queue using the common event envelope, not over HTTP.\n\nThe service runs as three interchangeable instances behind the gateway. Every response carries `X-Instance-Id`, and each instance registers itself with Service Discovery, which polls `/status`. Every peer call goes through a circuit breaker: three failures within 14 seconds open it for 14 seconds, then one trial call decides. Updating a location never answers `PEER_CIRCUIT_OPEN`: while the circuit is open the proximity check takes its existing degraded path at once and the location is still stored.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/map/api/v1",
      "description": "Gateway; external callers send bearer tokens. Trusted headers are injected by the gateway."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Locations",
      "description": "Current user location state"
    },
    {
      "name": "Map",
      "description": "Map visibility calculations"
    },
    {
      "name": "Operations",
      "description": "Liveness and readiness probes, internal network only"
    }
  ],
  "paths": {
    "/users/{userId}/location": {
      "put": {
        "operationId": "updateLocation",
        "summary": "Replace the user's current location",
        "description": "Callable only by the account owner. Updates with a sequenceNumber lower than or equal to the stored one are rejected.",
        "tags": [
          "Locations"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/X-Caller-Kind"
          },
          {
            "$ref": "#/components/parameters/X-User-ID"
          },
          {
            "$ref": "#/components/parameters/X-Session-ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Conflict: STALE_LOCATION_UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        }
      },
      "delete": {
        "operationId": "deleteLocation",
        "summary": "Remove the user's current location",
        "description": "Callable only by the account owner.",
        "tags": [
          "Locations"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/X-Caller-Kind"
          },
          {
            "$ref": "#/components/parameters/X-User-ID"
          },
          {
            "$ref": "#/components/parameters/X-Session-ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Location removed"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: LOCATION_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        }
      }
    },
    "/users/{userId}/map": {
      "get": {
        "operationId": "getMapView",
        "summary": "Retrieve the user's map view",
        "description": "Callable only by the account owner. Friends and enemies are included whenever both users have unexpired locations; a user with relationship NONE is included only when the calculated distance is at most 6 meters, and expired locations are omitted.",
        "tags": [
          "Map"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/X-Caller-Kind"
          },
          {
            "$ref": "#/components/parameters/X-User-ID"
          },
          {
            "$ref": "#/components/parameters/X-Session-ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Map view returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapViewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Not found: USER_OR_LOCATION_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "USER_SERVICE_UNAVAILABLE: User Management Service could not be reached; PEER_CIRCUIT_OPEN: User Management failed three times within 14 seconds, so this instance did not call it (sent with Retry-After: 14); or CONCURRENCY_LIMIT_REACHED: the service is already handling as many requests as it admits (sent with Retry-After: 1)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying: 14 for PEER_CIRCUIT_OPEN, 1 for CONCURRENCY_LIMIT_REACHED, absent otherwise",
                "schema": {
                  "type": "string",
                  "enum": [
                    "14",
                    "1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        }
      }
    },
    "/health": {
      "servers": [
        {
          "url": "/",
          "description": "Service root on the internal network, outside /api/v1; not exposed through the API Gateway"
        }
      ],
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness",
        "description": "Answers `200 {\"status\":\"UP\"}` whenever the process serves HTTP and checks nothing else, Redis included. A liveness probe that checked dependencies would restart every instance at once when a shared dependency failed, and a restart cannot bring the dependency back. Docker's healthcheck calls it. It needs no identity, bypasses the concurrency limit and is never cached.",
        "tags": [
          "Operations"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The process is serving HTTP",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Instance-Id": {
                "$ref": "#/components/headers/InstanceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "servers": [
        {
          "url": "/",
          "description": "Service root on the internal network, outside /api/v1; not exposed through the API Gateway"
        }
      ],
      "get": {
        "operationId": "getStatus",
        "summary": "Readiness and telemetry",
        "description": "Polled directly by Service Discovery every 4 seconds to decide whether this instance receives traffic. The status is the first rule that matches: Redis unreachable gives `DOWN` with `503`; utilization at or above 0.8, or User Management `DOWN` or its circuit open, gives `DEGRADED` with `200`; otherwise `UP` with `200`. Neither load nor a failing peer ever produces `DOWN`. Each datastore probe has its own one second deadline, the probes run concurrently and the result is reused for one second. Peers are never probed: their entries come from this instance's circuit breakers, `DOWN` while the circuit is open. It needs no identity, bypasses the concurrency limit and answers while every permit is taken.",
        "tags": [
          "Operations"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "`UP` or `DEGRADED`: the instance can serve",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Instance-Id": {
                "$ref": "#/components/headers/InstanceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                },
                "examples": {
                  "up": {
                    "summary": "Everything reachable",
                    "value": {
                      "status": "UP",
                      "service": "map",
                      "instanceId": "3f9a1c2e8b11",
                      "uptimeSeconds": 1423,
                      "load": {
                        "inFlight": 12,
                        "limit": 64,
                        "utilization": 0.19
                      },
                      "dependencies": [
                        {
                          "name": "redis",
                          "status": "UP",
                          "latencyMs": 2
                        },
                        {
                          "name": "user-management",
                          "status": "UP",
                          "circuit": "CLOSED"
                        }
                      ],
                      "checkedAt": "2026-10-29T09:12:05.331Z"
                    }
                  },
                  "degraded": {
                    "summary": "user-management circuit open",
                    "value": {
                      "status": "DEGRADED",
                      "service": "map",
                      "instanceId": "3f9a1c2e8b11",
                      "uptimeSeconds": 1423,
                      "load": {
                        "inFlight": 12,
                        "limit": 64,
                        "utilization": 0.19
                      },
                      "dependencies": [
                        {
                          "name": "redis",
                          "status": "UP",
                          "latencyMs": 2
                        },
                        {
                          "name": "user-management",
                          "status": "DOWN",
                          "circuit": "OPEN"
                        }
                      ],
                      "checkedAt": "2026-10-29T09:12:05.331Z"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "`DOWN`: Redis is unreachable, so nothing can be served",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Instance-Id": {
                "$ref": "#/components/headers/InstanceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                },
                "examples": {
                  "down": {
                    "summary": "Redis unreachable",
                    "value": {
                      "status": "DOWN",
                      "service": "map",
                      "instanceId": "3f9a1c2e8b11",
                      "uptimeSeconds": 1423,
                      "load": {
                        "inFlight": 0,
                        "limit": 64,
                        "utilization": 0.0
                      },
                      "dependencies": [
                        {
                          "name": "redis",
                          "status": "DOWN"
                        },
                        {
                          "name": "user-management",
                          "status": "UP",
                          "circuit": "CLOSED"
                        }
                      ],
                      "checkedAt": "2026-10-29T09:12:05.331Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer JWT issued by the authentication endpoints"
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "description": "Traces one operation across services and events; generated by the gateway when absent",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "description": "Global user identifier",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "X-Caller-Kind": {
        "name": "X-Caller-Kind",
        "in": "header",
        "required": false,
        "description": "Caller kind set by the gateway on every forwarded request: user, service or anonymous. Never accepted from an external client; a request that reaches the service without it is rejected with 401.",
        "schema": {
          "type": "string",
          "enum": [
            "user",
            "service",
            "anonymous"
          ]
        }
      },
      "X-User-ID": {
        "name": "X-User-ID",
        "in": "header",
        "required": false,
        "description": "Authenticated user UUID, set for user callers. Ownership and membership checks compare this value with the path parameter, never the reverse.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "X-Session-ID": {
        "name": "X-Session-ID",
        "in": "header",
        "required": false,
        "description": "Session UUID for user callers, when the token carries one.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or malformed gateway identity: MISSING_IDENTITY or INVALID_IDENTITY. The gateway is the only source of the identity headers, so a request arriving without them fails closed rather than being guessed at.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "CONCURRENCY_LIMIT_REACHED: the service is already handling as many requests as it admits and rejects the request at once instead of queueing it",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying",
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RequestTimeout": {
        "description": "Request deadline expired: REQUEST_TIMEOUT",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "correlationId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable error code",
                "examples": [
                  "RESOURCE_NOT_FOUND"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable error description"
              },
              "correlationId": {
                "type": "string",
                "format": "uuid",
                "description": "Correlation identifier of the failed operation"
              },
              "details": {
                "type": "array",
                "description": "Optional structured validation details",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "UpdateLocationRequest": {
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "recordedAt",
          "sequenceNumber"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latest latitude reported by the client"
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Latest longitude reported by the client"
          },
          "accuracyMeters": {
            "type": "number",
            "minimum": 0,
            "description": "Accuracy reported by the device"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time at which the device obtained the location"
          },
          "sequenceNumber": {
            "type": "integer",
            "minimum": 0,
            "description": "Monotonically increasing client value used to reject out-of-order updates"
          }
        }
      },
      "LocationResponse": {
        "type": "object",
        "required": [
          "userId",
          "latitude",
          "longitude",
          "accuracyMeters",
          "recordedAt",
          "expiresAt"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User associated with the location"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Stored latitude"
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Stored longitude"
          },
          "accuracyMeters": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Device accuracy when supplied"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time at which the device obtained the location"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time after which the location is no longer visible"
          }
        }
      },
      "MapViewResponse": {
        "type": "object",
        "required": [
          "userId",
          "generatedAt",
          "players"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User requesting the map"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time at which visibility was calculated"
          },
          "players": {
            "type": "array",
            "description": "Users visible according to the relationship and proximity rules",
            "items": {
              "$ref": "#/components/schemas/VisiblePlayer"
            }
          }
        }
      },
      "VisiblePlayer": {
        "type": "object",
        "required": [
          "userId",
          "relationship",
          "latitude",
          "longitude",
          "distanceMeters",
          "recordedAt"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Visible user identifier"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "FRIEND",
              "ENEMY",
              "NONE"
            ],
            "description": "Relationship returned by User Management Service"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latest unexpired latitude"
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Latest unexpired longitude"
          },
          "distanceMeters": {
            "type": "number",
            "minimum": 0,
            "description": "Calculated distance from the requesting user"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time at which the visible location was obtained"
          }
        }
      },
      "EventEnvelope": {
        "type": "object",
        "description": "Common envelope for every event sent through the message queue. Not delivered over HTTP.",
        "required": [
          "eventId",
          "eventType",
          "eventVersion",
          "occurredAt",
          "producer",
          "correlationId",
          "data"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique event identifier used for deduplication"
          },
          "eventType": {
            "type": "string",
            "description": "Stable event name including the version suffix",
            "examples": [
              "map.proximity.detected.v1"
            ]
          },
          "eventVersion": {
            "type": "integer",
            "description": "Schema version of the event"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time at which the business event occurred"
          },
          "producer": {
            "type": "string",
            "description": "Service that published the event",
            "examples": [
              "map-service"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier connecting the event to the originating operation"
          },
          "data": {
            "$ref": "#/components/schemas/MapProximityDetectedEventV1"
          }
        }
      },
      "MapProximityDetectedEventV1": {
        "type": "object",
        "description": "Payload of `map.proximity.detected.v1`, published when two unrelated users move from outside to inside the 6-meter threshold. Notification Service consumes it to notify the affected users.",
        "required": [
          "firstUserId",
          "secondUserId",
          "distanceMeters",
          "detectedAt"
        ],
        "properties": {
          "firstUserId": {
            "type": "string",
            "format": "uuid",
            "description": "First nearby user"
          },
          "secondUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Second nearby user"
          },
          "distanceMeters": {
            "type": "number",
            "minimum": 0,
            "description": "Distance calculated when the threshold was crossed"
          },
          "detectedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Detection time"
          }
        }
      },
      "LivenessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "UP"
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "instanceId",
          "uptimeSeconds",
          "load",
          "dependencies",
          "checkedAt"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DEGRADED",
              "DOWN"
            ]
          },
          "service": {
            "type": "string",
            "const": "map",
            "description": "Canonical service name, the route key in the gateway configuration"
          },
          "instanceId": {
            "type": "string",
            "description": "Hostname of this instance, the same value as X-Instance-Id"
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Whole seconds since the instance started serving"
          },
          "load": {
            "$ref": "#/components/schemas/InstanceLoad"
          },
          "dependencies": {
            "type": "array",
            "description": "Always `redis`, `user-management`",
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            }
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC with milliseconds and a Z suffix"
          }
        }
      },
      "InstanceLoad": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inFlight",
          "limit",
          "utilization"
        ],
        "properties": {
          "inFlight": {
            "type": "integer",
            "minimum": 0,
            "description": "Requests currently held by the concurrency limiter"
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "description": "MAX_CONCURRENCY"
          },
          "utilization": {
            "type": "number",
            "minimum": 0,
            "description": "inFlight / limit rounded to two decimals, 0.0 when the limit is 0"
          }
        }
      },
      "DependencyStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "redis",
              "user-management"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Datastores only, omitted when DOWN"
          },
          "circuit": {
            "type": "string",
            "enum": [
              "CLOSED",
              "OPEN"
            ],
            "description": "Peers only: the state of this instance's circuit breaker for that peer. A half-open circuit is reported as OPEN"
          }
        }
      }
    },
    "headers": {
      "InstanceId": {
        "description": "Hostname of the instance that answered. Every response carries it, errors included, so a caller can tell the instances apart",
        "schema": {
          "type": "string",
          "examples": [
            "3f9a1c2e8b11"
          ]
        }
      },
      "NoStore": {
        "description": "Operational answers are never cached",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      }
    }
  }
}
