          }
        },
        "responses": {
          "200": {
            "description": "Ownership transferred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnershipTransferResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/CallerNotAllowed"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict: OWNERSHIP_ALREADY_TRANSFERRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Rejected domain operation: INVALID_TRANSFER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ConcurrencyLimitReached"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        },
        "x-allowed-callers": ["battle-service"]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer JWT issued by User Management and verified by the API Gateway. The gateway removes the Authorization header and states the caller in the X-Caller-* headers, so the service never sees the token."
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "description": "Traces one operation across services and events. Generated by the gateway when absent, kept as received, echoed on every response and forwarded on the calls the request causes",
        "schema": {
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Deduplicates retriable commands that create side effects",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TamagotchiId": {
        "name": "tamagotchiId",
        "in": "path",
        "required": true,
        "description": "Global Tamagotchi identifier",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "description": "Global user identifier",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "CallerKind": {
        "name": "X-Caller-Kind",
        "in": "header",
        "required": true,
        "description": "Who the gateway verified the caller to be. Set by the API Gateway from the verified token. Clients never send it: the gateway removes any value a caller supplies and sets its own. A request without it is refused with 401 MISSING_IDENTITY, so a request that bypassed the gateway fails closed.",
        "schema": {
          "type": "string",
          "enum": ["user", "service", "anonymous"]
        }
      },
      "CallerUserId": {
        "name": "X-User-ID",
        "in": "header",
        "required": false,
        "description": "Authenticated user id, present for user callers. A user id in the path is a parameter, not an identity: ownership is decided by comparing it with this header. Set by the API Gateway from the verified token. Clients never send it: the gateway removes any value a caller supplies and sets its own.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "CallerSessionId": {
        "name": "X-Session-ID",
        "in": "header",
        "required": false,
        "description": "Session id of a user caller, when the token carries one. Set by the API Gateway from the verified token. Clients never send it: the gateway removes any value a caller supplies and sets its own.",
        "schema": {
          "type": "string"
        }
      },
      "CallerServiceName": {
        "name": "X-Service-Name",
        "in": "header",
        "required": false,
        "description": "Name of a calling service, present for service callers and compared with each operation's allowlist. Set by the API Gateway from the verified token. Clients never send it: the gateway removes any value a caller supplies and sets its own.",
        "schema": {
          "type": "string",
          "examples": ["battle-service"]
        }
      },
      "CallerScopes": {
        "name": "X-Scopes",
        "in": "header",
        "required": false,
        "description": "Space-separated scopes of a service caller, when its token carries any. Set by the API Gateway from the verified token. Clients never send it: the gateway removes any value a caller supplies and sets its own.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "MISSING_IDENTITY: the request reached the service without a complete caller identity from the gateway, or an anonymous caller reached an operation that needs one. Through the gateway, a missing or invalid token is answered by the gateway itself with MISSING_TOKEN or INVALID_TOKEN.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "NOT_RESOURCE_OWNER for another user, or CALLER_NOT_ALLOWED for a service not on the operation's allowlist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotResourceOwner": {
        "description": "NOT_RESOURCE_OWNER: the caller is not the user who owns the resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "CallerNotAllowed": {
        "description": "CALLER_NOT_ALLOWED: the operation is reserved for the listed services; users, the owner included, are refused",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ConcurrencyLimitReached": {
        "description": "CONCURRENCY_LIMIT_REACHED: the service is already serving its maximum number of requests and rejects the request at once instead of queueing it",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying",
            "schema": {
              "type": "integer",
              "examples": [1]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RequestTimeout": {
        "description": "REQUEST_TIMEOUT: the request did not finish within the service's deadline (REQUEST_TIMEOUT_SECONDS, 4 seconds by default)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "correlationId"],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable error code",
                "examples": ["RESOURCE_NOT_FOUND"]
              },
              "message": {
                "type": "string",
                "description": "Human-readable error description"
              },
              "correlationId": {
                "type": "string",
                "description": "Correlation identifier of the failed operation, as received in X-Correlation-ID or generated for the request"
              },
              "details": {
                "type": "array",
                "description": "Optional structured details; for VALIDATION_FAILED one entry per field with its field name and message",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "CreateTamagotchiRequest": {
        "type": "object",
        "required": ["ownerUserId", "packageId", "name", "combatType", "spriteUrl", "healthStats"],
        "properties": {
          "ownerUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Initial owner"
          },
          "packageId": {
            "type": "string",
            "format": "uuid",
            "description": "Package that defines the Tamagotchi's local statistics"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Tamagotchi display name"
          },
          "combatType": {
            "type": "string",
            "enum": ["FLAME", "NATURE", "EARTH", "ELECTRIC", "WATER", "SHADOW"],
            "description": "Predefined combat type"
          },
          "spriteUrl": {
            "type": "string",
            "format": "uri",
            "description": "Sprite reference"
          },
          "healthStats": {
            "type": "object",
            "additionalProperties": true,
            "description": "Package-local statistics validated against Package Registry definitions; values may be integer, decimal, or Boolean and unknown keys are rejected"
          }
        }
      },
      "UpdateTamagotchiRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Updated display name"
          },
          "spriteUrl": {
            "type": "string",
            "format": "uri",
            "description": "Updated sprite reference"
          }
        }
      },
      "TamagotchiResponse": {
        "type": "object",
        "required": ["tamagotchiId", "ownerUserId", "packageId", "name", "ownershipRole", "combatType", "level", "xp", "spriteUrl", "healthStats", "createdAt", "updatedAt"],
        "properties": {
          "tamagotchiId": {
            "type": "string",
            "format": "uuid",
            "description": "Global Tamagotchi identifier"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Current owner"
          },
          "packageId": {
            "type": "string",
            "format": "uuid",
            "description": "Originating package"
          },
          "name": {
            "type": "string",
            "description": "Display name"
          },
          "ownershipRole": {
            "type": "string",
            "enum": ["PRIMARY", "SECONDARY"],
            "description": "Role for the current owner"
          },
          "combatType": {
            "type": "string",
            "enum": ["FLAME", "NATURE", "EARTH", "ELECTRIC", "WATER", "SHADOW"],
            "description": "Current combat type"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "description": "Current level"
          },
          "xp": {
            "type": "integer",
            "minimum": 0,
            "description": "Total accumulated XP"
          },
          "spriteUrl": {
            "type": "string",
            "format": "uri",
            "description": "Sprite reference"
          },
          "healthStats": {
            "type": "object",
            "additionalProperties": true,
            "description": "Non-normalized package-local statistics; values may be integer, decimal, or Boolean per Package Registry definitions"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update time"
          }
        }
      },
      "SetPrimaryTamagotchiRequest": {
        "type": "object",
        "required": ["tamagotchiId"],
        "properties": {
          "tamagotchiId": {
            "type": "string",
            "format": "uuid",
            "description": "Owned Tamagotchi that becomes primary"
          }
        }
      },
      "UpdateHealthStatsRequest": {
        "type": "object",
        "required": ["stats"],
        "properties": {
          "stats": {
            "type": "object",
            "additionalProperties": true,
            "description": "Statistic keys and new values; values may be integer, decimal, or Boolean per Package Registry definitions and unknown keys are rejected"
          }
        }
      },
      "CombatTypeResponse": {
        "type": "object",
        "required": ["type", "strongAgainst"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["FLAME", "NATURE", "EARTH", "ELECTRIC", "WATER", "SHADOW"],
            "description": "One of the six predefined types"
          },
          "strongAgainst": {
            "type": "string",
            "enum": ["FLAME", "NATURE", "EARTH", "ELECTRIC", "WATER", "SHADOW"],
            "description": "Type against which it has an advantage"
          }
        }
      },
      "CombatProfileResponse": {
        "type": "object",
        "required": ["tamagotchiId", "ownerUserId", "packageId", "combatType", "level", "healthStats"],
        "properties": {
          "tamagotchiId": {
            "type": "string",
            "format": "uuid",
            "description": "Tamagotchi identifier"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Current owner"
          },
          "packageId": {
            "type": "string",
            "format": "uuid",
            "description": "Package used to interpret local statistics"
          },
          "combatType": {
            "type": "string",
            "enum": ["FLAME", "NATURE", "EARTH", "ELECTRIC", "WATER", "SHADOW"],
            "description": "Type used for advantage calculations"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "description": "Level used for combat calculations"
          },
          "healthStats": {
            "type": "object",
            "additionalProperties": true,
            "description": "Current package-local statistics; values may be integer, decimal, or Boolean per Package Registry definitions"
          }
        }
      },
      "GrantXpRequest": {
        "type": "object",
        "required": ["amount", "source", "referenceId"],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "XP to grant"
          },
          "source": {
            "type": "string",
            "enum": ["BATTLE", "RAID"],
            "description": "Activity producing the XP"
          },
          "referenceId": {
            "type": "string",
            "format": "uuid",
            "description": "Battle or raid identifier used for deduplication"
          }
        }
      },
      "GrantXpResponse": {
        "type": "object",
        "required": ["tamagotchiId", "previousLevel", "newLevel", "totalXp", "processedAt"],
        "properties": {
          "tamagotchiId": {
            "type": "string",
            "format": "uuid",
            "description": "Updated Tamagotchi"
          },
          "previousLevel": {
            "type": "integer",
            "minimum": 1,
            "description": "Level before the grant"
          },
          "newLevel": {
            "type": "integer",
            "minimum": 1,
            "description": "Level after the grant"
          },
          "totalXp": {
            "type": "integer",
            "minimum": 0,
            "description": "Total XP after the grant"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Grant processing time"
          }
        }
      },
      "TransferTamagotchiRequest": {
        "type": "object",
        "required": ["tamagotchiId", "fromUserId", "toUserId", "reason", "referenceId"],
        "properties": {
          "tamagotchiId": {
            "type": "string",
            "format": "uuid",
            "description": "Existing Tamagotchi to transfer"
          },
          "fromUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Current owner"
          },
          "toUserId": {
            "type": "string",
            "format": "uuid",
            "description": "New owner"
          },
          "reason": {
            "type": "string",
            "enum": ["BATTLE_REWARD"],
            "description": "Business reason for the transfer"
          },
          "referenceId": {
            "type": "string",
            "format": "uuid",
            "description": "Completed battle identifier used for deduplication"
          }
        }
      },
      "OwnershipTransferResponse": {
        "type": "object",
        "required": ["transferId", "tamagotchiId", "fromUserId", "toUserId", "newOwnershipRole", "transferredAt"],
        "properties": {
          "transferId": {
            "type": "string",
            "format": "uuid",
            "description": "Ownership-transfer identifier"
          },
          "tamagotchiId": {
            "type": "string",
            "format": "uuid",
            "description": "Transferred Tamagotchi"
          },
          "fromUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Previous owner"
          },
          "toUserId": {
            "type": "string",
            "format": "uuid",
            "description": "New owner"
          },
          "newOwnershipRole": {
            "type": "string",
            "enum": ["SECONDARY"],
            "description": "Role assigned to the captured Tamagotchi"
          },
          "transferredAt": {
            "type": "string",
            "format": "date-time",
            "description": "Transfer completion time"
          }
        }
      }
    }
  }
}
