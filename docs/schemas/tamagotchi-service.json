{
  "openapi": "3.1.0",
  "info": {
    "title": "Tamagotchi Service API",
    "version": "2.0.0",
    "description": "Owns every Tamagotchi and its current owner, ownership role, combat type, level, XP, sprite reference, and package-local health statistics. A secondary Tamagotchi is a reference to the original entity after an ownership transfer; the service never creates a duplicate of it. Package-local health statistics are validated against the definitions returned by Package Registry Service.\n\nThe service publishes no queue events.\n\n## Behind the API Gateway\n\nThe service is reachable only through the API Gateway, under the `/tamagotchi` prefix: the gateway strips the prefix and forwards the rest of the path and the query string unchanged. Clients authenticate at the gateway with a bearer token. The gateway verifies it, removes the `Authorization` header and states who the caller is in the `X-Caller-Kind`, `X-User-ID`, `X-Session-ID`, `X-Service-Name` and `X-Scopes` headers. The service never sees the token and trusts these headers only because nothing but the gateway can reach it; a request without `X-Caller-Kind` is refused with `401 MISSING_IDENTITY`.\n\nEach operation lists who may call it in its description and in `x-allowed-callers`, where `owner` is the user who owns the resource. A wrong user is refused with `403 NOT_RESOURCE_OWNER`, a service not on the list with `403 CALLER_NOT_ALLOWED`.\n\nEvery request is bounded by a deadline and answered `504 REQUEST_TIMEOUT` when it passes. At most a configured number of requests are served at once; one more is refused immediately with `503 CONCURRENCY_LIMIT_REACHED` and `Retry-After: 1`. `X-Correlation-ID` is kept as received, echoed on every response and forwarded on the calls the request causes.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Service base path, as the API Gateway forwards requests to it"
    },
    {
      "url": "http://localhost:8000/tamagotchi/api/v1",
      "description": "Through the API Gateway, the only entry point of the deployment"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Combat Types",
      "description": "Predefined combat types and their advantages"
    },
    {
      "name": "Tamagotchis",
      "description": "Tamagotchi creation, retrieval, updates, and health statistics"
    },
    {
      "name": "Ownership",
      "description": "Primary selection and ownership transfers"
    },
    {
      "name": "Progression",
      "description": "Combat profiles and XP grants"
    }
  ],
  "paths": {
    "/tamagotchi-combat-types": {
      "get": {
        "operationId": "listCombatTypes",
        "summary": "List the predefined combat types",
        "description": "Callable by clients and internal services. The type-advantage cycle is FLAME > NATURE > EARTH > ELECTRIC > WATER > SHADOW > FLAME. Allowed callers: any authenticated caller, user or service.",
        "tags": ["Combat Types"],
        "parameters": [
          {
            "$ref": "#/components/parameters/CallerKind"
          },
          {
            "$ref": "#/components/parameters/CallerUserId"
          },
          {
            "$ref": "#/components/parameters/CallerSessionId"
          },
          {
            "$ref": "#/components/parameters/CallerServiceName"
          },
          {
            "$ref": "#/components/parameters/CallerScopes"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Combat types returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CombatTypeResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/ConcurrencyLimitReached"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        },
        "x-allowed-callers": ["any"]
      }
    },
    "/tamagotchis": {
      "post": {
        "operationId": "createTamagotchi",
        "summary": "Create a Tamagotchi",
        "description": "Callable by the account owner or a package client. Health statistics are validated against the Package Registry definitions of the selected package. Allowed callers: the account owner.",
        "tags": ["Tamagotchis"],
        "parameters": [
          {
            "$ref": "#/components/parameters/CallerKind"
          },
          {
            "$ref": "#/components/parameters/CallerUserId"
          },
          {
            "$ref": "#/components/parameters/CallerSessionId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTamagotchiRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tamagotchi created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TamagotchiResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotResourceOwner"
          },
          "404": {
            "description": "Not found: PACKAGE_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: PRIMARY_TAMAGOTCHI_EXISTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Rejected domain operation: INVALID_LOCAL_STATS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "PACKAGE_REGISTRY_UNAVAILABLE: Package Registry Service could not be reached to validate the statistics, or CONCURRENCY_LIMIT_REACHED: the service is already serving its maximum number of requests (sent with Retry-After: 1)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "examples": [1]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        },
        "x-allowed-callers": ["owner"]
      }
    },
