{
  "info": {
    "name": "Tamagotchi Go - Notification Service",
    "description": "Notification Service endpoints through the API Gateway: Firebase device registrations, per-category notification preferences, and the owner-only rule that protects them.\n\nRun the folders in order. \"0. Authentication\" registers an owner and a second user through User Management and logs both in; \"1. Devices\" registers an installation for the owner and stores its identifiers for the requests that follow.\n\nFirebase registration tokens are confidential: they are sent when registering a device and are deliberately never returned in a response, which the tests assert.\n\npackageId defaults to 11111111-1111-4111-8111-111111111111, the package User Management's mock registry accepts at registration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ownerAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "baseUrl",
      "value": "{{gatewayUrl}}/notification/api/v1"
    },
    {
      "key": "userManagementUrl",
      "value": "{{gatewayUrl}}/user-management/api/v1"
    },
    {
      "key": "accountPassword",
      "value": "Collection-Test-Account-1"
    },
    {
      "key": "ownerUserId",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "packageId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "ownerAccessToken",
      "value": ""
    },
    {
      "key": "fcmToken",
      "value": ""
    },
    {
      "key": "ownerEmail",
      "value": ""
    },
    {
      "key": "ownerUsername",
      "value": ""
    },
    {
      "key": "otherUserId",
      "value": ""
    },
    {
      "key": "otherEmail",
      "value": ""
    },
    {
      "key": "otherUsername",
      "value": ""
    },
    {
      "key": "otherAccessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Register owner account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ownerUsername}}\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{accountPassword}}\",\n  \"initialPackageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36);",
                  "pm.collectionVariables.set('ownerEmail', 'owner-' + run + '@example.com');",
                  "pm.collectionVariables.set('ownerUsername', 'owner-' + run);",
                  "if (!pm.collectionVariables.get('packageId')) {",
                  "    pm.collectionVariables.set('packageId', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"ownerUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"ownerAccessToken\", pm.response.json().accessToken);",
                  "pm.test(\"Issues a bearer token\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register other account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{otherUsername}}\",\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{accountPassword}}\",\n  \"initialPackageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36);",
                  "pm.collectionVariables.set('otherEmail', 'other-' + run + '@example.com');",
                  "pm.collectionVariables.set('otherUsername', 'other-' + run);",
                  "if (!pm.collectionVariables.get('packageId')) {",
                  "    pm.collectionVariables.set('packageId', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"otherUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in other",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"otherAccessToken\", pm.response.json().accessToken);",
                  "pm.test(\"Issues a bearer token\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Devices",
      "item": [
        {
          "name": "Register device",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices/{{deviceId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmRegistrationToken\": \"{{fcmToken}}\",\n  \"platform\": \"ANDROID\",\n  \"packageId\": \"{{packageId}}\",\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('packageId')) {",
                  "    pm.collectionVariables.set('packageId', pm.variables.replaceIn('{{$guid}}'));",
                  "}",
                  "if (!pm.collectionVariables.get('deviceId')) {",
                  "    pm.collectionVariables.set('deviceId', pm.variables.replaceIn('{{$guid}}'));",
                  "}",
                  "pm.collectionVariables.set('fcmToken', 'confidential-fcm-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Registration is enabled\", () => pm.expect(body.enabled).to.be.true);",
                  "pm.test(\"Device keeps the identifier the client chose\", () =>",
                  "    pm.expect(body.deviceId).to.eql(pm.collectionVariables.get(\"deviceId\")));",
                  "pm.test(\"Firebase token is never returned\", () =>",
                  "    pm.expect(pm.response.text()).to.not.include(\"confidential-fcm-\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register device again - same installation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices/{{deviceId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmRegistrationToken\": \"{{fcmToken}}\",\n  \"platform\": \"ANDROID\",\n  \"packageId\": \"{{packageId}}\",\n  \"appVersion\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Re-registering updates rather than duplicating\", () =>",
                  "    pm.expect(pm.response.json().deviceId).to.eql(pm.collectionVariables.get(\"deviceId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "List devices",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"The installation is registered once\", () => pm.expect(body).to.have.lengthOf(1));",
                  "pm.test(\"Firebase token is never returned\", () =>",
                  "    pm.expect(pm.response.text()).to.not.include(\"confidential-fcm-\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register device - unknown platform",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices/{{$guid}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmRegistrationToken\": \"token\",\n  \"platform\": \"BLACKBERRY\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Reports a validation failure\", () =>",
                  "    pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_FAILED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Preferences",
      "item": [
        {
          "name": "Get preferences - defaults",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-preferences",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Every supported category is present\", () =>",
                  "    pm.expect(Object.keys(body.categories)).to.have.lengthOf(6));",
                  "pm.test(\"A user with no stored preference has them all enabled\", () =>",
                  "    Object.values(body.categories).forEach(it => pm.expect(it).to.be.true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update preferences",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-preferences",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categories\": {\n    \"PROXIMITY\": false,\n    \"BATTLE_REQUEST\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Disabled category is recorded\", () => pm.expect(body.categories.PROXIMITY).to.be.false);",
                  "pm.test(\"Untouched categories stay enabled\", () => {",
                  "    pm.expect(body.categories.BATTLE_REQUEST).to.be.true;",
                  "    pm.expect(body.categories.RAID_LIFECYCLE).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get preferences - after update",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-preferences",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"The update persisted\", () =>",
                  "    pm.expect(pm.response.json().categories.PROXIMITY).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update preferences - unknown category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-preferences",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categories\": {\n    \"NOT_A_CATEGORY\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Reports the unknown category\", () =>",
                  "    pm.expect(pm.response.json().error.code).to.eql(\"UNKNOWN_CATEGORY\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Access Rules",
      "item": [
        {
          "name": "List devices - no token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Reports MISSING_TOKEN\", () => pm.expect(pm.response.json().error.code).to.eql(\"MISSING_TOKEN\"));",
                  "pm.test(\"Error carries the correlation id\", () => pm.expect(pm.response.json().error.correlationId).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "List devices - another user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Reports NOT_RESOURCE_OWNER\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_RESOURCE_OWNER\"));",
                  "pm.test(\"Error carries the correlation id\", () => pm.expect(pm.response.json().error.correlationId).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register device - on another account",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices/{{$guid}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmRegistrationToken\": \"stolen-token\",\n  \"platform\": \"ANDROID\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Reports NOT_RESOURCE_OWNER\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_RESOURCE_OWNER\"));",
                  "pm.test(\"Error carries the correlation id\", () => pm.expect(pm.response.json().error.correlationId).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update preferences - another user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-preferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categories\": {\n    \"BATTLE_REQUEST\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Reports NOT_RESOURCE_OWNER\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_RESOURCE_OWNER\"));",
                  "pm.test(\"Error carries the correlation id\", () => pm.expect(pm.response.json().error.correlationId).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Device Removal",
      "item": [
        {
          "name": "Delete device",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices/{{deviceId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete device - already removed",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{ownerUserId}}/notification-devices/{{deviceId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Reports the device is missing\", () =>",
                  "    pm.expect(pm.response.json().error.code).to.eql(\"DEVICE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
