              "raw": "{\n  \"name\": \"Lab {{$guid}}\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Package created by the Lab 1 collection.\",\n  \"developerIds\": [\n    \"{{developerUserId}}\"\n  ]\n}",
