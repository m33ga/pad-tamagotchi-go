        {
          "name": "Create raid schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{registryBaseUrl}}/api/v1/raid-schedules",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"raidConfigurationId\": \"{{raidConfigurationId}}\",\n  \"startsAt\": \"{{raidStartsAt}}\",\n  \"endsAt\": \"{{raidEndsAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  var raidStart = new Date(Date.now() + 60 * 60 * 1000);",
                  "  var raidEnd = new Date(raidStart.getTime() + 60 * 60 * 1000);",
                  "  pm.variables.set(\"raidStartsAt\", raidStart.toISOString());",
                  "  pm.variables.set(\"raidEndsAt\", raidEnd.toISOString());",
                  "}());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "var createdRaidSchedule = pm.response.json();",
                  "pm.collectionVariables.set(\"scheduleId\", createdRaidSchedule.scheduleId);"
                ]
              }
            }
          ]
        },
