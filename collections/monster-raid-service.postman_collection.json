{
	"info": {
		"_postman_id": "6cf1ea86-e8a2-4ee9-a9a2-aca14373393b",
		"name": "Tamagotchi Go - Monster Raid Service",
		"description": "Generated from the Monster Raid Service OpenAPI 3.1 document (`docs/openapi/openapi.json` in the service repository).\n\nStart the common Docker Compose deployment, then run the requests in order: starting a raid stores a fresh `guildId` and the returned `raidId` in collection variables, which every later request reuses. `scheduleId` is the schedule the mocked Package Registry Service serves, and the monster it configures has 1000 health with 25 damage per attack, so 40 attacks finish a raid.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Raids",
			"item": [
				{
					"name": "Start a guild raid",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// A guild may only have one active raid, so every run uses a new guild.",
									"pm.collectionVariables.set('guildId', pm.variables.replaceIn('{{$guid}}'));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('raid created', () => pm.response.to.have.status(201));",
									"",
									"const raid = pm.response.json();",
									"pm.collectionVariables.set('raidId', raid.raidId);"
								]
							}
						}
					],
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "POST",
						"header": [
							{
								"description": "Correlation identifier; generated when absent",
								"key": "X-Correlation-ID",
								"value": "{{$guid}}",
								"disabled": true
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"scheduleId\": \"{{scheduleId}}\"\n}",
							"options": {
								"raw": {
									"headerFamily": "json",
									"language": "json"
								}
							}
