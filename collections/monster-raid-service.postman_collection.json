{
	"info": {
		"_postman_id": "6cf1ea86-e8a2-4ee9-a9a2-aca14373393b",
		"name": "Tamagotchi Go - Monster Raid Service",
		"description": "Requests go through the API Gateway, which verifies the bearer token and tells the service who the caller is. Run from top to bottom: Authentication logs in with an existing account and fetches the service token, and Setup creates the guild and reads the Tamagotchi and raid schedule the raid needs. Joining and attacking require a user token and refuse a service one. Keep passwords and client secrets local and never export populated tokens.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Authentication",
			"item": [
				{
					"name": "Login user through gateway",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{gatewayUrl}}/user-management/api/v1/auth/sessions",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
									"if (pm.response.code === 200) {",
									"  const body = pm.response.json();",
									"  pm.collectionVariables.set(\"accessToken\", body.accessToken);",
									"  // Read the subject returned by UMS; token verification is done by the gateway.",
									"  const payload = body.accessToken.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
									"  const claims = JSON.parse(atob(payload.padEnd(Math.ceil(payload.length / 4) * 4, \"=\")));",
									"  pm.collectionVariables.set(\"userId\", claims.sub);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Get service token through gateway",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [],
						"url": "{{gatewayUrl}}/user-management/api/v1/oauth2/token",
						"description": "Reads the active raid schedule below. Set serviceClientSecret from the private secrets/monster-raid-service.env of the deployment.",
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials"
								},
								{
									"key": "client_id",
									"value": "{{serviceClientId}}"
								},
								{
									"key": "client_secret",
									"value": "{{serviceClientSecret}}"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('client credentials succeed', () => pm.response.to.have.status(200));",
									"if (pm.response.code === 200) {",
									"  pm.collectionVariables.set('serviceAccessToken', pm.response.json().access_token);",
									"}"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "1. Setup",
			"item": [
				{
					"name": "Create a guild",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Raid collection {{$timestamp}}\",\n  \"description\": \"Guild created for this run\"\n}",
							"options": {
								"raw": {
									"headerFamily": "json",
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{gatewayUrl}}/guild/api/v1/guilds",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"guild",
								"api",
								"v1",
								"guilds"
							]
						},
						"description": "A raid belongs to a guild and the caller must be a member. Creating one makes the logged-in user its owner, and a fresh guild keeps the one-active-raid rule from blocking a second run."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('guild created', () => pm.response.to.have.status(201));",
									"pm.collectionVariables.set('guildId', pm.response.json().guildId);"
								]
							}
						}
					]
				},
				{
					"name": "Get the user's primary Tamagotchi",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{gatewayUrl}}/tamagotchi/api/v1/users/{{userId}}/primary-tamagotchi",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"tamagotchi",
								"api",
								"v1",
								"users",
								"{{userId}}",
								"primary-tamagotchi"
							]
						},
						"description": "The account needs a Tamagotchi before it can join a raid."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('primary Tamagotchi found', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('tamagotchiId', pm.response.json().tamagotchiId);"
								]
							}
						}
					]
				},
				{
					"name": "Find an active raid schedule",
					"request": {
						"method": "GET",
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{serviceAccessToken}}",
									"type": "string"
								}
							]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{gatewayUrl}}/package-registry/api/v1/raid-schedules?status=ACTIVE",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"package-registry",
								"api",
								"v1",
								"raid-schedules"
							],
							"query": [
								{
									"key": "status",
									"value": "ACTIVE"
								}
							]
						},
						"description": "Package Registry only shows schedules to an admin or an approved service client, so this one request uses the service token."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('an active schedule exists', () => pm.response.to.have.status(200));",
									"const schedules = pm.response.json();",
									"pm.test('at least one schedule is active', () => pm.expect(schedules).to.not.be.empty);",
									"if (schedules.length) {",
									"  pm.collectionVariables.set('scheduleId', schedules[0].scheduleId);",
									"}"
								]
							}
						}
					]
				}
			]
		},
