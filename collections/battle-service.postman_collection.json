{
  "info": {
    "_postman_id": "2548694d-5793-4818-843d-b4e8688d009c",
    "name": "Tamagotchi Go - Battle Service",
    "description": "Requests use the gateway. Run Authentication first with existing UMS account credentials saved locally. Login stores real access tokens and subjects for later requests. Service-only operations need the documented allowed client and its private client credential; a user token cannot authorize them. Business scenarios still require existing packages, pets and other referenced resources. Never export passwords, secrets or populated tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{challengerAccessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Correlation-ID', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login challenger through gateway",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/user-management/api/v1/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{challengerEmail}}\",\n  \"password\": \"{{challengerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"challengerAccessToken\", body.accessToken);",
                  "  // Read the subject returned by UMS; token verification is done by the gateway.",
                  "  const payload = body.accessToken.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "  const claims = JSON.parse(atob(payload.padEnd(Math.ceil(payload.length / 4) * 4, \"=\")));",
                  "  pm.collectionVariables.set(\"challengerUserId\", claims.sub);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login opponent through gateway",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/user-management/api/v1/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{opponentEmail}}\",\n  \"password\": \"{{opponentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"opponentAccessToken\", body.accessToken);",
                  "  // Read the subject returned by UMS; token verification is done by the gateway.",
                  "  const payload = body.accessToken.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "  const claims = JSON.parse(atob(payload.padEnd(Math.ceil(payload.length / 4) * 4, \"=\")));",
                  "  pm.collectionVariables.set(\"opponentUserId\", claims.sub);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Battle Requests",
      "item": [
        {
          "name": "Create battle request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{battleRequestIdempotencyKey}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"opponentUserId\": \"{{opponentUserId}}\",\n  \"primaryTamagotchiId\": \"{{challengerPrimaryTamagotchiId}}\",\n  \"secondaryTamagotchiId\": \"{{challengerSecondaryTamagotchiId}}\",\n  \"equippedBoosts\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/battle-requests"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('battleRequestIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('battleRequestId', body.battleRequestId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get battle request",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/battle-requests/{{battleRequestId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List sent battle requests",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/users/{{challengerUserId}}/battle-requests?direction=SENT&status=PENDING"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept battle request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{opponentAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"ACCEPT\",\n  \"primaryTamagotchiId\": \"{{opponentPrimaryTamagotchiId}}\",\n  \"secondaryTamagotchiId\": \"{{opponentSecondaryTamagotchiId}}\",\n  \"equippedBoosts\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/battle-requests/{{battleRequestId}}/responses"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('battleId', body.battle.battleId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Battles",
      "item": [
        {
          "name": "Get battle",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/battles/{{battleId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List active battles",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/users/{{challengerUserId}}/battles?status=ACTIVE&limit=20"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Perform attack",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{battleActionIdempotencyKey}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actionId\": \"{{actionId}}\",\n  \"type\": \"ATTACK\",\n  \"actorTamagotchiId\": \"{{challengerPrimaryTamagotchiId}}\",\n  \"targetTamagotchiId\": \"{{opponentPrimaryTamagotchiId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/battles/{{battleId}}/actions"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('actionId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('battleActionIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forfeit battle",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{opponentAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/battles/{{battleId}}/forfeitures"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
