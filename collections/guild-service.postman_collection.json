            "url": "{{gatewayUrl}}/user-management/api/v1/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{inviteeEmail}}\",\n  \"password\": \"{{inviteePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"inviteeAccessToken\", body.accessToken);",
                  "  // Read the subject returned by UMS; token verification is done by the gateway.",
                  "  const payload = body.accessToken.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "  const claims = JSON.parse(atob(payload.padEnd(Math.ceil(payload.length / 4) * 4, \"=\")));",
                  "  pm.collectionVariables.set(\"inviteeUserId\", claims.sub);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
