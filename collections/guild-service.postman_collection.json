{
  "info": {
    "_postman_id": "956346af-1261-4e0c-8998-93659632bb9f",
    "name": "Tamagotchi Go - Guild Service",
    "description": "Executable Lab 1 collection for the Guild Service HTTP contract. Start the common Docker Compose deployment, then run the requests in order. Bearer tokens use the mocked UUID identities documented by the service. WebSocket chat can be checked separately at ws://localhost:8081/ws/v1/guilds/{{guildId}}/chat with Authorization: Bearer {{ownerUserId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Guild Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{guildBaseUrl}}/healthz"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create guild",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{guildBaseUrl}}/api/v1/guilds",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerUserId}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Codex Keep\",\n  \"description\": \"A guild created by the Lab 1 Postman collection.\",\n  \"requiredPackageId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"guildId\", data.guildId);"
                ]
              }
            }
          ]
        },
