    {
      "name": "2. Tamagotchis",
      "item": [
        {
          "name": "Create tamagotchi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchis",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerUserId\": \"{{ownerUserId}}\",\n  \"packageId\": \"{{packageId}}\",\n  \"name\": \"Blaze\",\n  \"combatType\": \"FLAME\",\n  \"spriteUrl\": \"https://cdn.example.com/sprites/blaze.png\",\n  \"healthStats\": {\n    \"hunger\": 20,\n    \"tiredness\": 10,\n    \"happiness\": 80\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('ownerUserId')) {",
                  "    pm.collectionVariables.set('ownerUserId', pm.variables.replaceIn('{{$guid}}'));",
                  "}",
                  "if (!pm.collectionVariables.get('packageId')) {",
                  "    pm.collectionVariables.set('packageId', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"tamagotchiId\", body.tamagotchiId);",
                  "pm.test(\"First creature is the primary one\", () => pm.expect(body.ownershipRole).to.eql(\"PRIMARY\"));",
                  "pm.test(\"Starts at level 1 with no XP\", () => {",
                  "    pm.expect(body.level).to.eql(1);",
                  "    pm.expect(body.xp).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get tamagotchi",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}",
