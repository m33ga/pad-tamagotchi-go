                "exec": [
                  "if (!pm.collectionVariables.get('winnerUserId')) {",
                  "    pm.collectionVariables.set('winnerUserId', pm.variables.replaceIn('{{$guid}}'));",
                  "}",
                  "pm.collectionVariables.set('transferReferenceId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Winner receives it as secondary\", () => pm.expect(body.newOwnershipRole).to.eql(\"SECONDARY\"));",
                  "pm.test(\"Transfer records both sides\", () => {",
                  "    pm.expect(body.fromUserId).to.eql(pm.collectionVariables.get(\"ownerUserId\"));",
                  "    pm.expect(body.toUserId).to.eql(pm.collectionVariables.get(\"winnerUserId\"));",
                  "});"
                ]
              }
            }
