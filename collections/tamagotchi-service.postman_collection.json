              "mode": "raw",
              "raw": "{\n  \"tamagotchiId\": \"{{tamagotchiId}}\",\n  \"fromUserId\": \"{{ownerUserId}}\",\n  \"toUserId\": \"{{winnerUserId}}\",\n  \"reason\": \"BATTLE_REWARD\",\n  \"referenceId\": \"{{transferReferenceId}}\"\n}",
              "options": {
