                  "pm.test(\"Selected creature is now primary\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.tamagotchiId).to.eql(pm.collectionVariables.get(\"tamagotchiId\"));",
                  "    pm.expect(body.ownershipRole).to.eql(\"PRIMARY\");",
