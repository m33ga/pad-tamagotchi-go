    {
      "name": "5. XP Grants",
      "item": [
        {
          "name": "Grant XP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}/xp-grants",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 120,\n  \"source\": \"BATTLE\",\n  \"referenceId\": \"{{battleReferenceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('battleReferenceId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"XP is accumulated\", () => pm.expect(body.totalXp).to.be.at.least(120));",
                  "pm.test(\"Level reflects the new total\", () => pm.expect(body.newLevel).to.be.at.least(body.previousLevel));"
                ]
              }
            }
          ]
        },
        {
          "name": "Grant XP - replayed reference",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}/xp-grants",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 120,\n  \"source\": \"BATTLE\",\n  \"referenceId\": \"{{battleReferenceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Same reference is not granted twice\", () => pm.expect(pm.response.json().error.code).to.eql(\"XP_ALREADY_GRANTED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Ownership Transfers",
      "item": [
        {
          "name": "Transfer ownership",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchi-ownership-transfers",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tamagotchiId\": \"{{tamagotchiId}}\",\n  \"fromUserId\": \"{{ownerUserId}}\",\n  \"toUserId\": \"{{winnerUserId}}\",\n  \"reason\": \"BATTLE_REWARD\",\n  \"referenceId\": \"{{transferReferenceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('winnerUserId')) {",
                  "    pm.collectionVariables.set('winnerUserId', pm.variables.replaceIn('{{$guid}}'));",
                  "}",
                  "pm.collectionVariables.set('transferReferenceId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Winner receives it as secondary\", () => pm.expect(body.newOwnershipRole).to.eql(\"SECONDARY\"));",
                  "pm.test(\"Transfer records both sides\", () => {",
                  "    pm.expect(body.fromUserId).to.eql(pm.collectionVariables.get(\"ownerUserId\"));",
                  "    pm.expect(body.toUserId).to.eql(pm.collectionVariables.get(\"winnerUserId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer ownership - replayed reference",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchi-ownership-transfers",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tamagotchiId\": \"{{tamagotchiId}}\",\n  \"fromUserId\": \"{{ownerUserId}}\",\n  \"toUserId\": \"{{winnerUserId}}\",\n  \"reason\": \"BATTLE_REWARD\",\n  \"referenceId\": \"{{transferReferenceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Same battle cannot transfer twice\", () => pm.expect(pm.response.json().error.code).to.eql(\"OWNERSHIP_ALREADY_TRANSFERRED\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
