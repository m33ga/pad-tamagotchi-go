{
  "info": {
    "name": "Tamagotchi Go - Tamagotchi Service",
    "description": "Tamagotchi Service endpoints through the API Gateway: creature lifecycle, roster and primary selection, combat profile, XP grants, ownership transfers, and who may call each of them.\n\nRun the folders in order. \"0. Authentication\" registers an owner and a second user through User Management and logs both in, and obtains a battle-service token with the client-credentials grant. Owner requests use the owner's token; the combat profile, XP grant and ownership transfer requests use the battle-service token, as only Battle Service and Monster Raid Service may call them.\n\nSet battleClientSecret to BATTLE_CLIENT_SECRET from your local .env before running, and never export or commit it. packageId must name a package whose statistic definitions include hunger, tiredness and happiness once Package Registry is called for real; left empty, a random one is used, which only the mock registry accepts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ownerAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "baseUrl",
      "value": "{{gatewayUrl}}/tamagotchi/api/v1"
    },
    {
      "key": "userManagementUrl",
      "value": "{{gatewayUrl}}/user-management/api/v1"
    },
    {
      "key": "accountPassword",
      "value": "Collection-Test-Account-1"
    },
    {
      "key": "ownerUserId",
      "value": ""
    },
    {
      "key": "winnerUserId",
      "value": ""
    },
    {
      "key": "packageId",
      "value": ""
    },
    {
      "key": "tamagotchiId",
      "value": ""
    },
    {
      "key": "secondaryTamagotchiId",
      "value": ""
    },
    {
      "key": "ownerAccessToken",
      "value": ""
    },
    {
      "key": "battleReferenceId",
      "value": ""
    },
    {
      "key": "raidReferenceId",
      "value": ""
    },
    {
      "key": "transferReferenceId",
      "value": ""
    },
    {
      "key": "ownerEmail",
      "value": ""
    },
    {
      "key": "ownerUsername",
      "value": ""
    },
    {
      "key": "otherUserId",
      "value": ""
    },
    {
      "key": "otherEmail",
      "value": ""
    },
    {
      "key": "otherUsername",
      "value": ""
    },
    {
      "key": "otherAccessToken",
      "value": ""
    },
    {
      "key": "battleClientId",
      "value": "battle-service"
    },
    {
      "key": "battleClientSecret",
      "value": ""
    },
    {
      "key": "battleAccessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Register owner account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ownerUsername}}\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{accountPassword}}\",\n  \"initialPackageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36);",
                  "pm.collectionVariables.set('ownerEmail', 'owner-' + run + '@example.com');",
                  "pm.collectionVariables.set('ownerUsername', 'owner-' + run);",
                  "if (!pm.collectionVariables.get('packageId')) {",
                  "    pm.collectionVariables.set('packageId', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"ownerUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"ownerAccessToken\", pm.response.json().accessToken);",
                  "pm.test(\"Issues a bearer token\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register other account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{otherUsername}}\",\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{accountPassword}}\",\n  \"initialPackageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36);",
                  "pm.collectionVariables.set('otherEmail', 'other-' + run + '@example.com');",
                  "pm.collectionVariables.set('otherUsername', 'other-' + run);",
                  "if (!pm.collectionVariables.get('packageId')) {",
                  "    pm.collectionVariables.set('packageId', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"otherUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in other",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"otherAccessToken\", pm.response.json().accessToken);",
                  "pm.test(\"Issues a bearer token\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get battle-service token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{userManagementUrl}}/oauth2/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{battleClientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{battleClientSecret}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('battleClientSecret')) {",
                  "    console.warn('battleClientSecret is empty: set it to BATTLE_CLIENT_SECRET from your local .env. Never export or commit it.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"battleAccessToken\", pm.response.json().access_token);",
                  "pm.test(\"Issues a bearer service token\", () => pm.expect(pm.response.json().token_type).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Combat Types",
      "item": [
        {
          "name": "List combat types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tamagotchi-combat-types",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the six predefined types\", () => pm.expect(body).to.have.lengthOf(6));",
                  "pm.test(\"Each type declares what it beats\", () => body.forEach(it => {",
                  "    pm.expect(it).to.have.property(\"type\");",
                  "    pm.expect(it).to.have.property(\"strongAgainst\");",
                  "}));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Tamagotchis",
      "item": [
        {
          "name": "Create tamagotchi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchis",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerUserId\": \"{{ownerUserId}}\",\n  \"packageId\": \"{{packageId}}\",\n  \"name\": \"Blaze\",\n  \"combatType\": \"FLAME\",\n  \"spriteUrl\": \"https://cdn.example.com/sprites/blaze.png\",\n  \"healthStats\": {\n    \"hunger\": 20,\n    \"tiredness\": 10,\n    \"happiness\": 80\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('packageId')) {",
                  "    pm.collectionVariables.set('packageId', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"tamagotchiId\", body.tamagotchiId);",
                  "pm.test(\"First creature is the primary one\", () => pm.expect(body.ownershipRole).to.eql(\"PRIMARY\"));",
                  "pm.test(\"Starts at level 1 with no XP\", () => {",
                  "    pm.expect(body.level).to.eql(1);",
                  "    pm.expect(body.xp).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get tamagotchi",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the requested creature\", () => pm.expect(body.tamagotchiId).to.eql(pm.collectionVariables.get(\"tamagotchiId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update tamagotchi",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blaze the Brave\",\n  \"spriteUrl\": \"https://cdn.example.com/sprites/blaze-v2.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Name is updated\", () => pm.expect(pm.response.json().name).to.eql(\"Blaze the Brave\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update health stats",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}/health-stats",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stats\": {\n    \"hunger\": 55\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Supplied stat is applied\", () => pm.expect(body.healthStats.hunger).to.eql(55));",
                  "pm.test(\"Untouched stats are preserved\", () => pm.expect(body.healthStats.happiness).to.eql(80));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update health stats - unknown key",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}/health-stats",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stats\": {\n    \"notARealStat\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Rejected as invalid local stats\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_LOCAL_STATS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get tamagotchi - not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tamagotchis/00000000-0000-0000-0000-000000000000",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Reports the creature is missing\", () => pm.expect(pm.response.json().error.code).to.eql(\"TAMAGOTCHI_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
