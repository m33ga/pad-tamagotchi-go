    },
    {
      "name": "4. Combat Profile",
      "item": [
        {
          "name": "Get combat profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tamagotchis/{{tamagotchiId}}/combat-profile",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
