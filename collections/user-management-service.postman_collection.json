    {
      "name": "4. Balances",
      "item": [
        {
          "name": "Apply global balance transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{balanceIdempotencyKey}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"GLOBAL\",\n  \"amount\": 50,\n  \"reason\": \"BATTLE_REWARD\",\n  \"referenceId\": \"{{balanceReferenceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/{{userId}}/balances"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.variables.get('jwtSigningKey');",
                  "if (!secret || secret.length < 32) throw new Error('Set jwtSigningKey to the service local JWT key.');",
                  "const Crypto = require('crypto-js');",
                  "const encode = value => Crypto.enc.Base64.stringify(Crypto.enc.Utf8.parse(JSON.stringify(value))).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const unsigned = `${encode({ alg: 'HS256', typ: 'JWT' })}.${encode({ iss: 'tamagotchi-go', aud: 'tamagotchi-go', kind: 'service', service: 'battle-service', exp: Math.floor(Date.now() / 1000) + 300 })}`;",
                  "const signature = Crypto.enc.Base64.stringify(Crypto.HmacSHA256(unsigned, secret)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const token = `${unsigned}.${signature}`;",
                  "pm.collectionVariables.set('serviceAccessToken', token);",
                  "pm.collectionVariables.set('balanceReferenceId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('balanceIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
