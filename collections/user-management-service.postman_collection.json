              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{primaryUsername}}\",\n  \"email\": \"{{primaryEmail}}\",\n  \"password\": \"{{password}}\",\n  \"initialPackageId\": \"{{initialPackageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}-${Math.floor(Math.random() * 10000)}`;",
                  "pm.collectionVariables.set('runSuffix', suffix);",
                  "pm.collectionVariables.set('primaryUsername', `p1-${suffix}`);",
                  "pm.collectionVariables.set('primaryEmail', `postman-primary-${suffix}@example.com`);",
                  "pm.collectionVariables.set('peerUsername', `p2-${suffix}`);",
                  "pm.collectionVariables.set('peerEmail', `postman-peer-${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('userId', body.userId);"
                ]
              }
            }
          ]
