{
	"info": {
		"_postman_id": "15abb00b-7ae2-4948-a8e3-955f79bd4cb0",
		"name": "Tamagotchi Go - Map Service",
		"description": "Requests use the gateway. Run Authentication first with existing UMS account credentials saved locally. Login stores real access tokens and subjects for later requests. Service-only operations need the documented allowed client and its private client credential; a user token cannot authorize them. Business scenarios still require existing packages, pets and other referenced resources. Never export passwords, secrets or populated tokens.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Authentication",
			"item": [
				{
					"name": "Login user through gateway",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{gatewayUrl}}/user-management/api/v1/auth/sessions",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
									"if (pm.response.code === 200) {",
									"  const body = pm.response.json();",
									"  pm.collectionVariables.set(\"accessToken\", body.accessToken);",
									"  // Read the subject returned by UMS; token verification is done by the gateway.",
									"  const payload = body.accessToken.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
									"  const claims = JSON.parse(atob(payload.padEnd(Math.ceil(payload.length / 4) * 4, \"=\")));",
									"  pm.collectionVariables.set(\"userId\", claims.sub);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Login friend through gateway",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{gatewayUrl}}/user-management/api/v1/auth/sessions",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{friendEmail}}\",\n  \"password\": \"{{friendPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
									"if (pm.response.code === 200) {",
									"  const body = pm.response.json();",
									"  pm.collectionVariables.set(\"friendAccessToken\", body.accessToken);",
									"  // Read the subject returned by UMS; token verification is done by the gateway.",
									"  const payload = body.accessToken.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
									"  const claims = JSON.parse(atob(payload.padEnd(Math.ceil(payload.length / 4) * 4, \"=\")));",
									"  pm.collectionVariables.set(\"friendUserId\", claims.sub);",
									"}"
								]
							}
						}
					]
				}
			]
		},
